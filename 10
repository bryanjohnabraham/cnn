// STEP 1: Start the program
// STEP 2: Include the required header files for raw socket programming
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <arpa/inet.h>
#include <netinet/ip.h>
#include <net/ethernet.h>
#include <linux/if_packet.h>

#define BUFFER_SIZE 65536

int main() {
    int raw_sock;
    unsigned char buffer[BUFFER_SIZE];
    struct sockaddr saddr;
    socklen_t saddr_len = sizeof(saddr);

    // STEP 3: Create a raw socket using socket(PF_PACKET, SOCK_RAW, htons(ETH_P_ALL))
    raw_sock = socket(PF_PACKET, SOCK_RAW, htons(ETH_P_ALL));

    // STEP 4: Check whether the socket is created successfully
    if (raw_sock < 0) {
        perror("Socket creation failed (Root privileges required)");
        exit(EXIT_FAILURE);
    }

    // STEP 5: Display "Packet Capturing Started..."
    printf("Packet Capturing Started...\n");
    printf("Press Ctrl+C to terminate.\n\n");

    // STEP 10: Repeat Steps 6–9 for every incoming packet
    while (1) {
        // STEP 6: Receive packets continuously using recvfrom()
        int data_size = recvfrom(raw_sock, buffer, BUFFER_SIZE, 0, &saddr, &saddr_len);
        if (data_size < 0) {
            perror("Recvfrom error, failed to get packets");
            break;
        }

        // STEP 7: Extract the Ethernet header from the received packet
        struct ethhdr *eth = (struct ethhdr *)buffer;

        // Check if the Ethernet packet carries an IP packet (IPv4)
        if (ntohs(eth->h_proto) == ETH_P_IP) {
            // STEP 8: Extract the IP header from the packet
            // The IP header starts right after the Ethernet header
            struct iphdr *iph = (struct iphdr *)(buffer + sizeof(struct ethhdr));

            struct in_addr src, dst;
            src.s_addr = iph->saddr;
            dst.s_addr = iph->daddr;

            // STEP 9: Obtain and display Source IP, Destination IP, and Protocol number
            printf("--- IP Packet Received ---\n");
            printf("Source IP Address      : %s\n", inet_ntoa(src));
            printf("Destination IP Address : %s\n", inet_ntoa(dst));
            printf("Protocol Number        : %d\n", (unsigned int)iph->protocol);
            printf("Packet Size (bytes)    : %d\n\n", data_size);
        }
    }

    // STEP 11: Close the socket
    close(raw_sock);

    // STEP 12: Stop the program
    return 0;
}