#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>

#define PORT 9002
#define BUFFER_SIZE 4096

int main() {
    int server_fd, client_fd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    pid_t child_pid;

    // STEP 2: Create a TCP socket using socket()
    if ((server_fd = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // Set socket option to reuse port (prevents "Address already in use" errors)
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    // STEP 3: Initialize the server address structure
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    // STEP 4: Bind the socket to the specified port
    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // STEP 5: Put socket into listening mode
    if (listen(server_fd, 5) < 0) {
        perror("Listen failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // STEP 6: Display message indicating server is ready
    printf("Server is ready and waiting for client requests on port %d...\n", PORT);

    // STEP 18: Repeat Steps 7-17 for incoming requests
    while (1) {
        // STEP 7: Accept a client connection
        client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &addr_len);
        if (client_fd < 0) {
            perror("Accept failed");
            continue;
        }

        // STEP 8: Create a new child process using fork()
        child_pid = fork();

        if (child_pid < 0) {
            perror("Fork failed");
            close(client_fd);
            continue;
        }

        // STEP 9: In the child process
        if (child_pid == 0) {
            close(server_fd); // Close listening socket in child

            char filename[256];
            char response[BUFFER_SIZE];
            char line[256];
            memset(filename, 0, sizeof(filename));
            memset(response, 0, sizeof(response));

            // Receive the filename sent by the client
            int bytes_read = recv(client_fd, filename, sizeof(filename) - 1, 0);
            if (bytes_read > 0) {
                filename[bytes_read] = '\0';
                filename[strcspn(filename, "\r\n")] = 0; // Strip newline

                pid_t my_pid = getpid(); // Obtain child process ID

                // STEP 10: Attempt to open requested file
                FILE *file = fopen(filename, "r");

                // STEP 11: Check whether the file exists
                if (file != NULL) {
                    // STEP 12: File exists
                    snprintf(response, sizeof(response), "[Server PID %d]\nFile Contents:\n", my_pid);

                    // Read contents line by line
                    while (fgets(line, sizeof(line), file) != NULL) {
                        strncat(response, line, sizeof(response) - strlen(response) - 1);
                    }

                    // STEP 15: Close the file
                    fclose(file);
                } else {
                    // STEP 13: File does not exist
                    snprintf(response, sizeof(response), "[Server PID %d] Error: File not found.\n", my_pid);
                }

                // STEP 14: Send the prepared response
                send(client_fd, response, strlen(response), 0);
            }

            // STEP 16: Close client socket and terminate child process
            close(client_fd);
            exit(0);
        }

        // STEP 17: In the parent process
        close(client_fd); // Close connected client socket in parent
    }

    // STEP 19 & 20: Close server socket and terminate
    close(server_fd);
    return 0;
}