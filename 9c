#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 9002
#define BUFFER_SIZE 4096

int main() {
    int sock_fd;
    struct sockaddr_in server_addr;
    char filename[256];
    char buffer[BUFFER_SIZE];

    // STEP 2: Create a TCP socket using socket()
    if ((sock_fd = socket(AF_INET, SOCK_STREAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // STEP 3: Initialize the server address structure
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1"); // Localhost IP

    // STEP 4: Establish a connection using connect()
    if (connect(sock_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection failed");
        close(sock_fd);
        exit(EXIT_FAILURE);
    }

    // STEP 5: Prompt user for filename
    printf("Enter the name of the required file: ");

    // STEP 6: Read filename from user
    if (fgets(filename, sizeof(filename), stdin) != NULL) {
        filename[strcspn(filename, "\r\n")] = 0; // Strip trailing newline

        // STEP 7: Send the filename to the server
        send(sock_fd, filename, strlen(filename), 0);

        // STEP 8 & 9: Wait for and receive response
        memset(buffer, 0, sizeof(buffer));
        int bytes_received = recv(sock_fd, buffer, sizeof(buffer) - 1, 0);

        if (bytes_received > 0) {
            buffer[bytes_received] = '\0';
            // STEP 10: Display the received information
            printf("\n--- Server Response ---\n%s\n", buffer);
        } else {
            printf("No response or error receiving data from server.\n");
        }
    }

    // STEP 11: Close the socket connection
    close(sock_fd);

    // STEP 12: Stop the client program
    return 0;
}