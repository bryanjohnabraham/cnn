#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 1234
#define BUFFER_SIZE 1024

int main() {
    int sockfd;
    struct sockaddr_in server_addr;
    char buffer[BUFFER_SIZE];
    socklen_t addr_len = sizeof(server_addr);

    // STEP 3: Create a UDP socket
    if ((sockfd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // STEP 4: Define the server address structure
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1"); // Set server IP address

    // STEP 10: Repeat until the user enters "stop"
    while (1) {
        memset(buffer, 0, BUFFER_SIZE);

        // STEP 5: Read a message from the user
        printf("Enter message (or type 'stop' to exit): ");
        fgets(buffer, BUFFER_SIZE, stdin);
        buffer[strcspn(buffer, "\n")] = 0; // Remove trailing newline

        // STEP 7: Send the message to the server
        sendto(sockfd, (const char *)buffer, strlen(buffer), MSG_CONFIRM, (const struct sockaddr *)&server_addr, sizeof(server_addr));

        // STEP 6: Check whether the message is "stop"
        // Note: The stop message must be sent first so the server knows to shut down.
        if (strcmp(buffer, "stop") == 0) {
            break;
        }

        // STEP 8: Receive the current time from the server
        memset(buffer, 0, BUFFER_SIZE);
        int n = recvfrom(sockfd, (char *)buffer, BUFFER_SIZE, MSG_WAITALL, (struct sockaddr *)&server_addr, &addr_len);
        buffer[n] = '\0';

        // STEP 9: Display the received time
        printf("Server Time: %s\n", buffer);
    }

    // STEP 11: Close the socket
    close(sockfd);
    
    // STEP 12: Stop the program
    return 0; 
}