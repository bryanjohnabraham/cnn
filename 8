#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <time.h>

#define PORT 1234
#define BUFFER_SIZE 1024

int main() {
    int sockfd;
    struct sockaddr_in server_addr, client_addr;
    char buffer[BUFFER_SIZE];
    socklen_t addr_len = sizeof(client_addr);
    time_t rawtime;
    struct tm *timeinfo;

    // STEP 3: Create a UDP socket
    if ((sockfd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // STEP 4: Define the server address structure
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = INADDR_ANY;

    // STEP 5: Bind the socket
    if (bind(sockfd, (const struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(sockfd);
        exit(EXIT_FAILURE);
    }

    printf("UDP Time Server is listening on port %d...\n", PORT);

    // STEP 12: Repeat until the client sends "stop"
    while (1) {
        memset(buffer, 0, BUFFER_SIZE);

        // STEP 6: Wait for a message from the client
        int n = recvfrom(sockfd, (char *)buffer, BUFFER_SIZE, MSG_WAITALL, (struct sockaddr *)&client_addr, &addr_len);
        buffer[n] = '\0';
        buffer[strcspn(buffer, "\n")] = 0; // Remove trailing newline

        // STEP 7: Display the received message
        printf("Client message: %s\n", buffer);

        // STEP 8: Check whether the received message is "stop"
        if (strcmp(buffer, "stop") == 0) {
            printf("Termination signal received. Shutting down server.\n");
            break;
        }

        // STEP 9: Obtain the current system time
        time(&rawtime);
        timeinfo = localtime(&rawtime);

        // STEP 10: Format the time as a string
        char time_buffer[BUFFER_SIZE];
        strftime(time_buffer, sizeof(time_buffer), "%Y-%m-%d %H:%M:%S", timeinfo);

        // STEP 11: Send the formatted time to the client
        sendto(sockfd, (const char *)time_buffer, strlen(time_buffer), MSG_CONFIRM, (const struct sockaddr *)&client_addr, addr_len);
    }

    // STEP 13: Close the socket
    close(sockfd);
    
    // STEP 14: Stop the program
    return 0; 
}